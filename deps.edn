{:paths ["src" "resources"]

 :deps
 {aero/aero {:mvn/version "1.1.6"}
  reagent/reagent         {:mvn/version "1.2.0"}
  re-frame/re-frame       {:mvn/version "1.4.3"}
  day8.re-frame/http-fx   {:mvn/version "0.2.4"}
  metosin/reitit-frontend {:mvn/version "0.9.2"}
  cljs-ajax/cljs-ajax     {:mvn/version "0.8.4"}
  thheller/shadow-cljs    {:mvn/version "3.3.4"}}

 :aliases
 {
  :dev
  {:extra-paths ["dev"]
   :extra-deps  {com.stuartsierra/component.repl {:mvn/version "0.2.0"}
                 org.clojure/tools.namespace     {:mvn/version "1.5.0"}}}
  
  :storm
  {:classpath-overrides {org.clojure/clojurescript nil}
   :extra-deps {com.github.flow-storm/clojurescript {:mvn/version "1.12.42-0"}
                com.github.flow-storm/flow-storm-inst {:mvn/version "4.4.4"}
                com.google.javascript/closure-compiler {:mvn/version "v20250407"}}
   :jvm-opts ["-Dcljs.storm.instrumentEnable=true"
              "-Dcljs.storm.instrumentOnlyPrefixes=user-hub"
              "-Dflowstorm.startRecording=true"]}

  :final
  {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]}

  :shadow
  {:main-opts ["-m" "shadow.cljs.devtools.cli"]}}}