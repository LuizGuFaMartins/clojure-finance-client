{
  "name": "clojure-finance-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "rm -rf public/js public/css .shadow-cljs",
    "build:css": "tailwindcss -i ./public/index.css -o ./public/css/main.css",
    "build:js": "npx shadow-cljs release clojure-finance -A :final",
    "build:js:debug": "npx shadow-cljs release :clojure-finance -A :final --debug",
    "build": "npm-run-all build:js build:css",
    "watch:css": "npm run build:css -- --watch",
    "watch:js": "npx shadow-cljs watch :clojure-finance -A :dev",
    "dev": "npm-run-all --parallel watch:*"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "shadow-cljs": "2.28.16",
    "tailwindcss": "^3.4.19"
  }
}