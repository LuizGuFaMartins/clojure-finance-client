{
  "name": "clojure-finance-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "rm -rf resources/static/js resources/static/css .shadow-cljs",
    "tailwind:watch": "tailwindcss -i ./public/index.css -o ./resources/static/css/app.css --watch",
    "tailwind:release": "tailwindcss -i ./public/index.css -o ./resources/static/css/app.css --minify",
    "shadow:watch": "shadow-cljs -A:dev watch app",
    "shadow:release": "shadow-cljs -A:final release app",
    "dev": "npm-run-all --parallel tailwind:watch shadow:watch",
    "build": "npm run tailwind:release && npm run shadow:release"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "shadow-cljs": "2.28.16",
    "tailwindcss": "^3.4.19"
  }
}